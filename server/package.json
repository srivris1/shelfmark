{
  "name": "shelfmark-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@electric-sql/pglite": "^0.5.8",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
