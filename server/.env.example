# Copy this file to `.env` (same folder) and fill in what you need.
# Everything is optional for local development: with no .env at all the app
# uses a built-in Postgres (PGlite), generates its own secrets and seeds demo data.

# ---- Database -------------------------------------------------------------
# Leave empty to use PGlite (files in server/data/). For a real Postgres server,
# e.g. Neon (free): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ---- Secrets (REQUIRED when NODE_ENV=production) --------------------------
# Generate each one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# QR_SECRET signs the printed book labels. If you change it, reprint the labels.
JWT_SECRET=
QR_SECRET=

# ---- First admin account (used when the staff table is empty) -------------
ADMIN_NAME=Library Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Load the demo books, borrowers and logins on an empty database.
# Defaults to true locally and false in production.
SEED_DEMO=

# ---- Library rules ---------------------------------------------------------
LOAN_DAYS=14
MAX_ACTIVE_LOANS=5
FINE_PER_DAY=5
# Time zone used for report timestamps and "today" on the dashboard
REPORT_TIMEZONE=Asia/Kolkata

# ---- Smart search (optional) ----------------------------------------------
# Set ONE of these. Without a key, smart search uses built-in offline rules.
# Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Force a provider (claude | gemini | none) or a specific model id
AI_PROVIDER=
AI_MODEL=

# ---- Server ----------------------------------------------------------------
PORT=4000
# NODE_ENV=production
# Set to false only if you run a production build on plain http://localhost
# COOKIE_SECURE=false
